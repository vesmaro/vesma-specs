# Generated by `vesma service install` — service-lifecycle v1 (specs/service-lifecycle/v1).
# Do NOT edit by hand: regeneration overwrites this file.
# Destination (user profile): ~/.config/systemd/user/vesma.service
# The unit NEVER contains component argv: ExecStart below is the static
# supervisor launch line; children are spawned by the supervisor via the
# execve array from each manifest's launch.argv (spec §3.6).

[Unit]
Description=VESMA supervisor (single unit over the vesma process; systemd never knows about children)
Documentation=https://github.com/vesmaro/vesma-specs/tree/main/specs/service-lifecycle/v1
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
# RuntimeDirectory is systemd-created writable even under
# ProtectSystem=strict + ProtectHome=read-only (which make /run/user
# read-only) — the control socket dir ${XDG_RUNTIME_DIR}/vesma must
# exist inside the unit namespace (issue vesmaro/vesma#509).
RuntimeDirectory=vesma
RuntimeDirectoryMode=0700
ExecStart=%h/.local/share/vesma/venv/bin/vesma service run
# ExecStop is intentionally NOT generated: the default SIGTERM to the main
# process IS the contract stop (reverse-topological graceful stop of children
# performed inside the supervisor; children are invisible to systemd).
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=90
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

# --- hardening block (service-lifecycle v1, MUST) ---
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=%h/.local/state/vesma %h/.cache/vesma %h/.local/share/vesma
# venv trees are created by the install flow only; at runtime they are
# read-only (carves venv/venvs out of the writable share root — spec §3.6).
ReadOnlyPaths=%h/.local/share/vesma/venv %h/.local/share/vesma/venvs
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
# MemoryDenyWriteExecute is deliberately ABSENT: it breaks CPython native
# extensions (see spec section 3.6, "MemoryDenyWriteExecute").
# SystemCallFilter=@system-service
# ^ Tier B: uncommented by the generator only after the smoke matrix
#   (bare / distrobox / podman); until then it stays commented with this
#   loud marker — no silent downgrades.

[Install]
WantedBy=default.target
