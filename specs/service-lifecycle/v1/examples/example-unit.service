# Generated by `vesma service install` — service-lifecycle v1 (specs/service-lifecycle/v1).
# Do NOT edit by hand: regeneration overwrites this file.
# Destination (user profile): ~/.config/systemd/user/vesma.service
# ExecStart arguments come from launch manifests of the installed components;
# the line below is a canonical placeholder (one line, no `sh -c`).

[Unit]
Description=VESMA supervisor (single unit over the vesma process; systemd never knows about children)
Documentation=https://github.com/vesmaro/vesma-specs/tree/main/specs/service-lifecycle/v1
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
ExecStart=%h/.local/share/vesma/venv/bin/vesma service run
# ExecStop is intentionally NOT generated: the default SIGTERM to the main
# process IS the contract stop (reverse-topological graceful stop of children
# performed inside the supervisor; children are invisible to systemd).
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=90
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

# --- hardening block (service-lifecycle v1, MUST) ---
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=%h/.local/state/vesma %h/.cache/vesma %h/.local/share/vesma
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
# MemoryDenyWriteExecute is deliberately ABSENT: it breaks CPython native
# extensions (see spec section 3.6, "MemoryDenyWriteExecute").
# SystemCallFilter=@system-service
# ^ Tier B: uncommented by the generator only after the smoke matrix
#   (bare / distrobox / podman); until then it stays commented with this
#   loud marker — no silent downgrades.

[Install]
WantedBy=default.target
